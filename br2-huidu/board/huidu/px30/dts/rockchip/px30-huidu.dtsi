// SPDX-License-Identifier: (GPL-2.0+ OR MIT)
/*
 * Huidu PX30 LED controllers (C15 / C35 / C36 / D15): common board part.
 *
 * Ported from the stock Rockchip BSP 4.4.159 DTB of the D15
 * (products/BoxPlayer/v7.11.18.0/hardware/D15_rk-kernel.dts). The C-series
 * DTBs have not been captured yet; everything here is D15-derived.
 * See README.md next to this file for the stock -> mainline mapping.
 */

#include <dt-bindings/gpio/gpio.h>
#include <dt-bindings/input/input.h>
#include <dt-bindings/interrupt-controller/irq.h>
#include <dt-bindings/leds/common.h>
#include <dt-bindings/pinctrl/rockchip.h>
/*
 * Buildroot copies custom DTS/DTSI to arch/arm64/boot/dts/ (not the rockchip/
 * subdir), so the SoC dtsi is not a sibling. Reference it through the kernel's
 * dtc include-prefixes (scripts/dtc/include-prefixes/arm64 -> arch/arm64/boot/dts).
 */
#include <arm64/rockchip/px30.dtsi>

/ {
	aliases {
		ethernet0 = &gmac;
		mmc0 = &emmc;
		rtc0 = &pcf8563;
		rtc1 = &rk809;
		serial1 = &uart1;
		serial2 = &uart2;
	};

	chosen {
		bootargs = "console=ttyS2,115200n8 earlycon=uart8250,mmio32,0xff160000 rootwait";
		stdout-path = "serial2:115200n8";
	};

	/* stock: vccsys */
	vcc5v0_sys: regulator-vcc5v0-sys {
		compatible = "regulator-fixed";
		regulator-name = "vcc5v0_sys";
		regulator-always-on;
		regulator-boot-on;
		regulator-min-microvolt = <5000000>;
		regulator-max-microvolt = <5000000>;
	};

	/* stock: vcc-phy-regulator (no voltage given in stock, no enable GPIO) */
	vcc_phy: regulator-vcc-phy {
		compatible = "regulator-fixed";
		regulator-name = "vcc_phy";
		regulator-always-on;
		regulator-boot-on;
	};

	/*
	 * stock: pcie-control (compatible "huidu,pcie-control", chardev "3g_reset").
	 * The stock driver requests GPIO0_A5 as "pcie_pwren" and drives it HIGH at
	 * probe (disassembly of the 4.4 Image); ioctls toggle it later. Modelled as
	 * the 4G modem (EC200T) power switch.
	 * TODO: drop always-on if user space needs to power-cycle the modem.
	 */
	vcc_4g: regulator-vcc-4g {
		compatible = "regulator-fixed";
		regulator-name = "vcc_4g";
		gpio = <&gpio0 RK_PA5 GPIO_ACTIVE_HIGH>;
		enable-active-high;
		pinctrl-names = "default";
		pinctrl-0 = <&modem_pwren>;
		regulator-always-on;
		regulator-boot-on;
		vin-supply = <&vcc5v0_sys>;
	};

	leds {
		compatible = "gpio-leds";

		/* stock: leds/sys_run */
		led-0 {
			label = "sys-run";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_HEARTBEAT;
			gpios = <&gpio1 RK_PC5 GPIO_ACTIVE_LOW>;
			linux,default-trigger = "heartbeat";
			default-state = "on";
		};

		/* stock: led-control (huidu,led-control) "led_red" */
		led-1 {
			label = "led-red";
			color = <LED_COLOR_ID_RED>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PB4 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};

		/* stock: led-control (huidu,led-control) "led_green" */
		led-2 {
			label = "led-green";
			color = <LED_COLOR_ID_GREEN>;
			function = LED_FUNCTION_STATUS;
			gpios = <&gpio0 RK_PB5 GPIO_ACTIVE_HIGH>;
			default-state = "off";
		};
	};

	/* stock: key/test-key (rockchip,key), KEY 0x94 = KEY_PROG1 */
	gpio-keys {
		compatible = "gpio-keys";

		button-test {
			label = "test-key";
			linux,code = <KEY_PROG1>;
			/* TODO verify polarity: stock flag is 0 (active high) */
			gpios = <&gpio1 RK_PC4 GPIO_ACTIVE_HIGH>;
			debounce-interval = <20>;
		};
	};
};

&cpu0 {
	cpu-supply = <&vdd_arm>;
};

&cpu1 {
	cpu-supply = <&vdd_arm>;
};

&cpu2 {
	cpu-supply = <&vdd_arm>;
};

&cpu3 {
	cpu-supply = <&vdd_arm>;
};

&emmc {
	bus-width = <8>;
	cap-mmc-highspeed;
	mmc-hs200-1_8v;
	non-removable;
	/* stock declares no vmmc/vqmmc for eMMC; bootloader-configured rails */
	status = "okay";
};

&gmac {
	clock_in_out = "input";
	/* RMII 50 MHz reference comes in from the PHY/oscillator (gmac_clkin) */
	assigned-clocks = <&cru SCLK_GMAC>;
	assigned-clock-parents = <&gmac_clkin>;
	phy-handle = <&rmii_phy>;
	phy-supply = <&vcc_phy>;
	snps,reset-gpio = <&gpio2 RK_PB5 GPIO_ACTIVE_LOW>;
	snps,reset-active-low;
	snps,reset-delays-us = <0 50000 50000>;
	status = "okay";
};

&mdio {
	/*
	 * Stock has no PHY node (generic probe). No "reg" here on purpose:
	 * of_mdiobus auto-scans addresses 0..31 for a PHY without reg.
	 * TODO set reg once the PHY address is known (dmesg of stock unit).
	 */
	rmii_phy: ethernet-phy {
		compatible = "ethernet-phy-ieee802.3-c22";
	};
};

&gpu {
	mali-supply = <&vdd_log>;
	status = "okay";
};

&i2c0 {
	status = "okay";

	rk809: pmic@20 {
		compatible = "rockchip,rk809";
		reg = <0x20>;
		interrupt-parent = <&gpio0>;
		interrupts = <RK_PA7 IRQ_TYPE_LEVEL_LOW>;
		pinctrl-names = "default";
		pinctrl-0 = <&pmic_int>;
		system-power-controller;
		wakeup-source;
		#clock-cells = <1>;
		clock-output-names = "rk808-clkout1", "xin32k";

		vcc1-supply = <&vcc5v0_sys>;
		vcc2-supply = <&vcc5v0_sys>;
		vcc3-supply = <&vcc5v0_sys>;
		vcc4-supply = <&vcc5v0_sys>;
		vcc5-supply = <&vcc3v3_sys>;
		vcc6-supply = <&vcc3v3_sys>;
		vcc7-supply = <&vcc3v3_sys>;
		vcc8-supply = <&vcc3v3_sys>;
		vcc9-supply = <&vcc5v0_sys>;

		regulators {
			vdd_log: DCDC_REG1 {
				regulator-name = "vdd_logic";
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <2>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vdd_arm: DCDC_REG2 {
				regulator-name = "vdd_arm";
				regulator-min-microvolt = <950000>;
				regulator-max-microvolt = <1350000>;
				regulator-ramp-delay = <6001>;
				regulator-initial-mode = <2>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <950000>;
				};
			};

			vcc_ddr: DCDC_REG3 {
				regulator-name = "vcc_ddr";
				regulator-initial-mode = <2>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
				};
			};

			vcc_3v0: DCDC_REG4 {
				regulator-name = "vcc_3v0";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-initial-mode = <2>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc3v3_sys: DCDC_REG5 {
				regulator-name = "vcc3v3_sys";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_1v0: LDO_REG1 {
				regulator-name = "vcc_1v0";
				regulator-min-microvolt = <1050000>;
				regulator-max-microvolt = <1050000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1050000>;
				};
			};

			vcc1v8_soc: LDO_REG2 {
				regulator-name = "vcc1v8_soc";
				regulator-min-microvolt = <1850000>;
				regulator-max-microvolt = <1850000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1850000>;
				};
			};

			vcc1v0_soc: LDO_REG3 {
				regulator-name = "vcc1v0_soc";
				regulator-min-microvolt = <1000000>;
				regulator-max-microvolt = <1000000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1000000>;
				};
			};

			vcc3v0_pmu: LDO_REG4 {
				regulator-name = "vcc3v0_pmu";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vccio_sd: LDO_REG5 {
				regulator-name = "vccio_sd";
				regulator-min-microvolt = <1800000>;
				regulator-max-microvolt = <3300000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc_sd: LDO_REG6 {
				regulator-name = "vcc_sd";
				regulator-min-microvolt = <3300000>;
				regulator-max-microvolt = <3300000>;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <3300000>;
				};
			};

			vcc2v8_dvp: LDO_REG7 {
				regulator-name = "vcc2v8_dvp";
				regulator-min-microvolt = <2500000>;
				regulator-max-microvolt = <2500000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <2500000>;
				};
			};

			vcc1v8_dvp: LDO_REG8 {
				regulator-name = "vcc1v8_dvp";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-on-in-suspend;
					regulator-suspend-microvolt = <1200000>;
				};
			};

			vdd1v5_dvp: LDO_REG9 {
				regulator-name = "vdd1v5_dvp";
				regulator-min-microvolt = <1200000>;
				regulator-max-microvolt = <1200000>;
				regulator-always-on;
				regulator-boot-on;

				regulator-state-mem {
					regulator-off-in-suspend;
					regulator-suspend-microvolt = <1200000>;
				};
			};

			vcc3v3_lcd: SWITCH_REG1 {
				regulator-name = "vcc3v3_lcd";
				regulator-boot-on;
			};

			vcc5v0_host: SWITCH_REG2 {
				regulator-name = "vcc5v0_host";
				regulator-always-on;
				regulator-boot-on;
			};
		};
	};
};

&i2c1 {
	status = "okay";

	pcf8563: rtc@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
	};
};

/* stock: grf/io-domains. Stock sets no vccio6 (flash) supply: left to the bootloader. */
&io_domains {
	vccio1-supply = <&vcc1v8_soc>;
	vccio2-supply = <&vccio_sd>;
	vccio3-supply = <&vcc_3v0>;
	vccio4-supply = <&vcc3v0_pmu>;
	vccio5-supply = <&vcc_3v0>;
	status = "okay";
};

&pmu_io_domains {
	pmuio1-supply = <&vcc3v0_pmu>;
	pmuio2-supply = <&vcc3v0_pmu>;
	status = "okay";
};

&pinctrl {
	modem {
		modem_pwren: modem-pwren {
			rockchip,pins = <0 RK_PA5 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	fpga {
		fpga_ctrl_pins: fpga-ctrl-pins {
			rockchip,pins =
				<0 RK_PA0 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PA1 RK_FUNC_GPIO &pcfg_pull_none>,
				<0 RK_PA2 RK_FUNC_GPIO &pcfg_pull_none>;
		};
	};

	pmic {
		pmic_int: pmic-int {
			rockchip,pins = <0 RK_PA7 RK_FUNC_GPIO &pcfg_pull_up>;
		};
	};
};

&saradc {
	/* ch0 = board revision resistor strap (read by libCore) */
	vref-supply = <&vcc1v8_soc>;
	status = "okay";
};

&spi0 {
	status = "okay";

	/*
	 * Stock: spi_cyclone4@00 { compatible = "huidu,spi_bus0_cs0"; 12 MHz;
	 *   gpios = <GPIO0_A0 0>, <GPIO0_A1 0>, <GPIO0_A2 0>; } driven by the
	 * out-of-tree drivers/char/cyclone4.c (/dev/cyclone4). Its probe does
	 *   of_get_named_gpio(np, "gpios", 2) -> "io_conf_done"
	 *   of_get_named_gpio(np, "gpios", 0) -> "io_nconfig"
	 *   of_get_named_gpio(np, "gpios", 1) -> "io_nstatus"
	 * then drives nCONFIG output-high (idle) and makes the other two inputs.
	 * So: A0 = nCONFIG, A1 = nSTATUS, A2 = CONF_DONE (raw levels, no inversion).
	 * nCONFIG/nSTATUS are active-low per the Altera PS protocol.
	 * TODO verify pin roles on hardware; the Huidu fpga.img is not a plain
	 * RBF (8-byte header, sync CC 55 AA 33), so this driver may not be able
	 * to load it as-is (bit order / header) - see README.md.
	 */
	fpga@0 {
		compatible = "altr,fpga-passive-serial";
		reg = <0>;
		spi-max-frequency = <12000000>;
		pinctrl-names = "default";
		pinctrl-0 = <&fpga_ctrl_pins>;
		nconfig-gpios = <&gpio0 RK_PA0 GPIO_ACTIVE_LOW>;
		nstat-gpios = <&gpio0 RK_PA1 GPIO_ACTIVE_LOW>;
		confd-gpios = <&gpio0 RK_PA2 GPIO_ACTIVE_HIGH>;
	};
};

&tsadc {
	status = "okay";
};

&u2phy {
	status = "okay";
};

&u2phy_host {
	phy-supply = <&vcc5v0_host>;
	status = "okay";
};

&u2phy_otg {
	status = "okay";
};

/* FPGA control/status link, /dev/ttyS1, 115200 8N1 (stock pinctrl: xfer + cts) */
&uart1 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart1_xfer &uart1_cts>;
	status = "okay";
};

/* Debug console, uart2m0 on GPIO1_D2/D3 (stock: fiq-debugger ttyFIQ0) */
&uart2 {
	pinctrl-names = "default";
	pinctrl-0 = <&uart2m0_xfer>;
	status = "okay";
};

&usb20_otg {
	dr_mode = "otg";
	status = "okay";
};

/* rtl8188eu Wi-Fi and Quectel EC200T 4G hang off the host port */
&usb_host0_ehci {
	status = "okay";
};

&usb_host0_ohci {
	status = "okay";
};

/* Hantro G1/H1 (stock vpu_service + vpu_combo) */
&vpu {
	status = "okay";
};

&vpu_mmu {
	status = "okay";
};

&wdt {
	status = "okay";
};

/*
 * Display path (VOPB -> internal RGB -> panel-dpi -> FPGA) is completed in
 * the per-model .dts; the shared parts live here.
 */
&display_subsystem {
	status = "okay";
};

&vopb {
	/* RGB888 m0 pins: stock rgb node pinctrl (dclk, den, hsync, vsync, data) */
	pinctrl-names = "default";
	pinctrl-0 = <&lcdc_rgb_dclk_pin &lcdc_rgb_m0_den_pin
		     &lcdc_rgb_m0_hsync_pin &lcdc_rgb_m0_vsync_pin
		     &lcdc_rgb888_m0_data_pins>;
	status = "okay";
};

&vopb_mmu {
	status = "okay";
};
