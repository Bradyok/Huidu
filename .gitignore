# Large firmware / installer binaries
*.exe
*.zbin
*.7z
*.zip
*.rar
*.apk

# Extracted application directories (too large for git, reference locally)
hdplayer_extracted/
extracted_APKs/
firmware_extract/

# Rust build output
/huidu-player/target

# Specific large files already excluded by pattern above but listed for clarity
BoxPlayer_V7.11.18.0_MagicPlayer_V2.12.8.0.zbin
/hdplayer-client/target/debug
/hdplayer-client/target
/target/debug
Upgrade Huidu.pcapng
/fw_repack_work
/target/release

# HDPlayer release archive (tools/hdplayer_release.py): binaries, strings and
# decompiled C stay local; MANIFEST.json, VERSION_DIFF.md and exports/ are committed
/products/*/v*/full/
/products/*/v*/strings/
/products/*/v*/decompiled/

# Secrets: generated root passwords for access/upgrade packages — never commit
*.password.txt

# Built firmware upgrade packages (large; regenerate with packages/*/build.py)
packages/**/*.bin
*.bin
custom_upgrade.tar.gz

# Buildroot / WSL build outputs live outside the repo (~/huidu-br); ignore any local copy
br2-huidu/output*/
br2-huidu/dl/
